# Server Port
PORT=5000

# MongoDB Atlas or Local Connection String
# For MongoDB Atlas (Free Tier): mongodb+srv://<username>:<password>@cluster0.mongodb.net/volunteer_connect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/volunteer_connect

# JWT Secret for Auth
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
